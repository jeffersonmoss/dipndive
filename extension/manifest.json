{
  "manifest_version": 3,
  "name": "Dip and Dive",
  "version": "0.1.0",
  "description": "Right-click a link or page for a short summary from your own companion service.",
  "key": "",
  "minimum_chrome_version": "114",
  "permissions": [
    "contextMenus",
    "sidePanel",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.ts.net/*"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Dip and Dive"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
